{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run AI Video Studio Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "watch AI Video Studio Extension"
    }
  ]
}
