{
  "name": "ai-video-studio",
  "displayName": "AI Video Studio",
  "description": "在 VS Code 中管理和生成 AI 视频作品。",
  "version": "0.0.1",
  "icon": "resources/logo.png",
  "publisher": "chengbin",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sengbin/ai-video-studio.git"
  },
  "engines": {
    "vscode": "^1.108.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "AI",
    "AI video",
    "AI 视频",
    "智影"
  ],
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "AI Video Studio",
      "properties": {
        "aiVideoStudio.copilot.modelFamily": {
          "type": "string",
          "default": "",
          "markdownDescription": "生成文本时使用的 Copilot 模型家族（如 `gpt-4o`）。留空表示自动选择；所选模型不可用时回退到自动。"
        },
        "aiVideoStudio.novel.splitMode": {
          "type": "string",
          "enum": [
            "chapter",
            "length"
          ],
          "enumDescriptions": [
            "按章节标题切分，识别不到章节标题时自动改为按字数",
            "按字数切分"
          ],
          "default": "chapter",
          "description": "长小说的分段方式。"
        },
        "aiVideoStudio.novel.maxSegmentChars": {
          "type": "integer",
          "default": 20000,
          "minimum": 2000,
          "maximum": 100000,
          "description": "小说每段的字数上限。按章节分段时，单章超过此值会在段落处再切分。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiVideoStudio",
          "title": "AI Video Studio",
          "icon": "./resources/vscode.svg"
        }
      ]
    },
    "views": {
      "aiVideoStudio": [
        {
          "id": "aiVideoStudio.sidebar",
          "name": "",
          "type": "webview",
          "icon": "./resources/vscode.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/**/*.test.js\" \"ui-kit/test/**/*.test.mjs\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.108.0",
    "@vscode/vsce": "^4.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2"
  }
}
