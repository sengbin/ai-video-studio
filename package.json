          "icon": "./resources/vscode.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test \"out/**/*.test.js\"",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.108.0",
    "@vscode/vsce": "^4.0.0",
